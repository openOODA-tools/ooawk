// # Model Context Protocol (MCP) Stdio Server for ooawk
//
// Logline: JSON-RPC 2.0 stdio server providing text projection, record filtering, and column aggregations.
//
// Setup: Demands FsReadCap for input file access and stdio streaming. Operates without ambient authority.
//
// Beats:
//   1. Process incoming JSON-RPC 2.0 requests over standard input.
//   2. Dispatch initialize, tools/list, and tools/call methods.
//   3. Stream capability-bounded responses for record filtering, projection, and arithmetic stats.

import "core/expr_eval.oo";
import "core/record_engine.oo";
import "render/awk_theme.oo";
import "ipc/json_field.oo";

pub fn run_mcp_server(fs: &FsReadCap) {
    let mut running: Bool = true;
    while running {
        let line_res: Result[String, String] = oo_read_stdin_chunk(fs, 8192);
        if !line_res.is_ok() {
            running = false;
        } else {
            let line: String = match line_res { Ok(s) => s, Err(_) => "" };
            let trimmed: String = str_trim(line);
            if chars_len(trimmed) == 0 {
                running = false;
            } else {
                let id: String = json_get_field(trimmed, "id");
                let method: String = json_get_string(trimmed, "method");

                if method == "initialize" {
                    let resp: String = "{\"jsonrpc\":\"2.0\",\"id\":" + id +
                        ",\"result\":{\"protocolVersion\":\"2024-11-05\"," +
                        "\"serverInfo\":{\"name\":\"ooawk\",\"version\":\"0.2.0\"}," +
                        "\"capabilities\":{\"tools\":{}}}}";
                    println(resp);
                } else if method == "notifications/initialized" {
                    // ack
                } else if method == "tools/list" {
                    let t1: String = "{\"name\":\"awk_eval\",\"description\":\"Project fields and apply predicate filters across text lines\"," +
                        "\"inputSchema\":{\"type\":\"object\",\"properties\":{\"text\":{\"type\":\"string\"},\"fs\":{\"type\":\"string\"},\"ofs\":{\"type\":\"string\"},\"cols\":{\"type\":\"string\"}},\"required\":[\"text\"]}}";
                    let t2: String = "{\"name\":\"awk_filter\",\"description\":\"Filter lines by column predicate (operator ==, !=, >, <, contains)\"," +
                        "\"inputSchema\":{\"type\":\"object\",\"properties\":{\"text\":{\"type\":\"string\"},\"fs\":{\"type\":\"string\"},\"col\":{\"type\":\"integer\"},\"op\":{\"type\":\"string\"},\"val\":{\"type\":\"string\"}},\"required\":[\"text\",\"col\",\"op\",\"val\"]}}";
                    let t3: String = "{\"name\":\"awk_project\",\"description\":\"Extract specific 1-indexed column numbers from text lines\"," +
                        "\"inputSchema\":{\"type\":\"object\",\"properties\":{\"text\":{\"type\":\"string\"},\"fs\":{\"type\":\"string\"},\"cols\":{\"type\":\"string\"}},\"required\":[\"text\",\"cols\"]}}";
                    let t4: String = "{\"name\":\"awk_stats\",\"description\":\"Compute exact integer statistical aggregates (count, sum, min, max, mean) on a column\"," +
                        "\"inputSchema\":{\"type\":\"object\",\"properties\":{\"text\":{\"type\":\"string\"},\"fs\":{\"type\":\"string\"},\"col\":{\"type\":\"integer\"}},\"required\":[\"text\",\"col\"]}}";
                    let resp: String = "{\"jsonrpc\":\"2.0\",\"id\":" + id +
                        ",\"result\":{\"tools\":[" + t1 + "," + t2 + "," + t3 + "," + t4 + "]}}";
                    println(resp);
                } else if method == "tools/call" {
                    let params: String = json_get_field(trimmed, "params");
                    let tool_name: String = json_get_string(params, "name");
                    let args: String = json_get_field(params, "arguments");

                    if tool_name == "awk_eval" || tool_name == "awk_project" {
                        let text_in: String = json_get_string(args, "text");
                        let fs_in: String = json_get_string(args, "fs");
                        let fs_sep: String = if chars_len(fs_in) > 0 { fs_in } else { " " };
                        let ofs_in: String = json_get_string(args, "ofs");
                        let ofs: String = if chars_len(ofs_in) > 0 { ofs_in } else { " " };
                        let cols_str: String = json_get_string(args, "cols");
                        let cols: List[Int] = parse_column_list(cols_str);
                        let lines: List[String] = process_text_stream(text_in, fs_sep, ofs, cols, -1, "", "");
                        let j: String = render_lines_json(lines);
                        let resp: String = "{\"jsonrpc\":\"2.0\",\"id\":" + id +
                            ",\"result\":{\"content\":[{\"type\":\"text\",\"text\":\"" + json_escape(j) + "\"}]}}";
                        println(resp);
                    } else if tool_name == "awk_filter" {
                        let text_in: String = json_get_string(args, "text");
                        let fs_in: String = json_get_string(args, "fs");
                        let fs_sep: String = if chars_len(fs_in) > 0 { fs_in } else { " " };
                        let col_str: String = json_get_field(args, "col");
                        let col_idx: Int = parse_int_val(col_str);
                        let op: String = json_get_string(args, "op");
                        let val: String = json_get_string(args, "val");
                        let cols: List[Int] = list_new();
                        let lines: List[String] = process_text_stream(text_in, fs_sep, " ", cols, col_idx, op, val);
                        let j: String = render_lines_json(lines);
                        let resp: String = "{\"jsonrpc\":\"2.0\",\"id\":" + id +
                            ",\"result\":{\"content\":[{\"type\":\"text\",\"text\":\"" + json_escape(j) + "\"}]}}";
                        println(resp);
                    } else if tool_name == "awk_stats" {
                        let text_in: String = json_get_string(args, "text");
                        let fs_in: String = json_get_string(args, "fs");
                        let fs_sep: String = if chars_len(fs_in) > 0 { fs_in } else { " " };
                        let col_str: String = json_get_field(args, "col");
                        let col_idx: Int = parse_int_val(col_str);
                        let stats: AwkStatsResult = aggregate_column_stream(text_in, fs_sep, col_idx);
                        let j: String = render_stats_json(stats, col_idx);
                        let resp: String = "{\"jsonrpc\":\"2.0\",\"id\":" + id +
                            ",\"result\":{\"content\":[{\"type\":\"text\",\"text\":\"" + json_escape(j) + "\"}]}}";
                        println(resp);
                    } else {
                        let resp: String = "{\"jsonrpc\":\"2.0\",\"id\":" + id +
                            ",\"error\":{\"code\":-32601,\"message\":\"Method not found\"}}";
                        println(resp);
                    }
                } else {
                    let resp: String = "{\"jsonrpc\":\"2.0\",\"id\":" + id +
                        ",\"error\":{\"code\":-32601,\"message\":\"Method not found\"}}";
                    println(resp);
                }
            }
        }
    }
}
